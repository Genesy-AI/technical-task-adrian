# Backend runtime configuration. All variables are required.
# In a worktree this file is generated as backend/.env by scripts/worktree-setup.sh;
# otherwise copy it to backend/.env and adjust.

# HTTP port of the API. Must be unique per running checkout.
PORT=4000

# SQLite database, relative to prisma/schema.prisma. Each checkout has its own copy.
DATABASE_URL="file:./dev.db"

# Temporal frontend (gRPC). A single dev server is shared by all checkouts.
TEMPORAL_ADDRESS=localhost:7233
# One namespace per checkout isolates workflows, IDs and task queues.
# Create it with `pnpm temporal:namespace` (the setup script does this for you).
TEMPORAL_NAMESPACE=tinyenginy-main
TEMPORAL_TASK_QUEUE=tinyenginy
